+func issue150RuntimeFile(t *testing.T, name string, data []byte, id protocol.ShortID, sequence int64) protocol.FileInfo {
+	t.Helper()
+	blockSize := protocol.BlockSize(int64(len(data)))
+	blocks, err := scanner.Blocks(t.Context(), bytes.NewReader(data), blockSize, int64(len(data)), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return protocol.FileInfo{
+		Name:         name,
+		Type:         protocol.FileInfoTypeFile,
+		Size:         int64(len(data)),
+		ModifiedS:    time.Now().Unix(),
+		Permissions:  0o644,
+		RawBlockSize: int32(blockSize),
+		Blocks:       blocks,
+		Version:      protocol.Vector{}.Update(id),
+		Sequence:     sequence,
+	}
+}
