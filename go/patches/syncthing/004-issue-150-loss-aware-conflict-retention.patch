+func issue150RequireRuntimeSafetyError(t *testing.T, err error) {
+	t.Helper()
+	expected := config.ErrVaultSyncReceiveSideSafetyStop
+	if err == nil {
+		t.Fatalf("protected scan returned nil, want %q", expected.Error())
+	}
+	if !errors.Is(err, expected) {
+		t.Errorf("protected scan error = %v, want canonical safety stop", err)
+	}
+	if got := err.Error(); got != expected.Error() {
+		t.Errorf("protected scan error = %q, want exact path-free %q", got, expected.Error())
+	}
+}
