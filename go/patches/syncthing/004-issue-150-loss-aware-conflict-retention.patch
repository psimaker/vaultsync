+const issue150TrackingFilesystemType fs.FilesystemType = "issue150-tracking"
+
+var issue150TrackingFilesystems sync.Map
+
+func init() {
+	fs.RegisterFilesystemType(issue150TrackingFilesystemType, func(root string, opts ...fs.Option) (fs.Filesystem, error) {
+		if existing, ok := issue150TrackingFilesystems.Load(root); ok {
+			return existing.(*issue150TrackingFilesystem), nil
+		}
+		created := &issue150TrackingFilesystem{
+			Filesystem: fs.NewFilesystem(fs.FilesystemTypeFake, root, opts...),
+		}
+		actual, _ := issue150TrackingFilesystems.LoadOrStore(root, created)
+		return actual.(*issue150TrackingFilesystem), nil
+	})
+}
