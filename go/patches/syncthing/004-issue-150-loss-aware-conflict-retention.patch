+		t.Fatal("pure send-only configuration entered receive-side protection")
+	}
+	app.mainService = suture.New("issue150-sendonly", svcutil.SpecWithDebugLogger())
+	if err := app.startup(); err != nil {
+		t.Fatal(err)
+	}
+	for _, call := range []string{"Service", "ListFolders", "GetKV", "PutKV"} {
+		if got := spy.count(call); got == 0 {
+			t.Errorf("pure send-only startup no longer called standard DB surface %s", call)
+		}
+	}
+}
