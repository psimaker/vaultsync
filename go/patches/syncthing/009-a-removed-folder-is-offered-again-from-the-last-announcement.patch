+}
+
+// noteAnnounced replaces what the device announced on this connection.
+func (r *indexHandlerRegistry) noteAnnounced(announced map[string]announcedFolder) {
+	r.mut.Lock()
+	r.announced = announced
+	r.mut.Unlock()
+}
+
+// announcedFolder returns what the device's last cluster config on this
+// connection said about the folder, if it named it.
+func (r *indexHandlerRegistry) announcedFolder(folder string) (announcedFolder, bool) {
+	r.mut.Lock()
+	defer r.mut.Unlock()
+	a, ok := r.announced[folder]
+	return a, ok
+}
+
+// forgetFolder is Remove for a folder that is gone from the configuration:
+// its state goes too, so start info given later waits as a pending folder's
+// does instead of starting a handler for a folder that is not configured.
+func (r *indexHandlerRegistry) forgetFolder(folder string) {
+	r.Remove(folder)
+	r.mut.Lock()
+	delete(r.folderStates, folder)
+	r.mut.Unlock()
+}
