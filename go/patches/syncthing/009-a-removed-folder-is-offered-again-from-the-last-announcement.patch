+// offerRemovedFoldersAgain makes a removed folder pending again for every
+// connected device that announced it in its last cluster config on the
+// connection that is up (VaultSync, #341). A device that goes on sharing a
+// folder removed here announces it only when a connection is set up or its
+// own configuration changes, so the offer used to come back only with the
+// next connection. What is written is what that cluster config writes for a
+// folder this side does not have (ccHandleFolders): the pending entry and,
+// where the folder runs on the device, the index start info, so that an
+// accept on this connection starts the index exchange instead of closing the
+// connection at the device's first index. Nothing is closed and nothing is
+// written to the configuration.
+func (m *model) offerRemovedFoldersAgain(removedFolders map[string]struct{}, existingDevices map[protocol.DeviceID]config.DeviceConfiguration) {
+	if len(removedFolders) == 0 {
+		return
+	}
+	type connected struct {
+		device   protocol.DeviceID
+		registry *indexHandlerRegistry
+	}
+	var registries []connected
+	m.mut.RLock()
+	m.indexHandlers.Each(func(device protocol.DeviceID, r *indexHandlerRegistry) error {
+		registries = append(registries, connected{device, r})
+		return nil
+	})
+	m.mut.RUnlock()
+
+	now := time.Now().Truncate(time.Second)
+	var offered []updatedPendingFolder
+	for folderID := range removedFolders {
+		for _, c := range registries {
+			dev, ok := existingDevices[c.device]
+			if !ok || dev.IgnoredFolder(folderID) {
+				continue
+			}
+			a, ok := c.registry.announcedFolder(folderID)
+			if !ok {
+				continue
+			}
+			of := db.ObservedFolder{
+				Time:             now,
+				Label:            a.label,
+				ReceiveEncrypted: a.receiveEncrypted,
+				RemoteEncrypted:  a.remoteEncrypted,
+			}
+			if err := m.observed.AddOrUpdatePendingFolder(folderID, of, c.device); err != nil {
+				slog.Warn("Failed to persist pending folder entry to database", slogutil.Error(err))
+				continue
+			}
+			if a.running {
+				c.registry.AddIndexInfo(folderID, a.info)
+			}
+			l.Debugf("Removed folder %s is offered again by %v from its last cluster config", folderID, c.device.Short())
+			offered = append(offered, updatedPendingFolder{
+				FolderID:         folderID,
+				FolderLabel:      a.label,
+				DeviceID:         c.device,
+				ReceiveEncrypted: a.receiveEncrypted,
+				RemoteEncrypted:  a.remoteEncrypted,
+			})
+		}
+	}
+	if len(offered) > 0 {
+		m.evLogger.Log(events.PendingFoldersChanged, map[string]interface{}{
+			"added": offered,
+		})
+	}
+}
