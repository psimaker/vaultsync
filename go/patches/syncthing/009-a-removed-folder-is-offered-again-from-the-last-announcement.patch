+// runs in a replay between its read of a device's announcement and its write;
+// the second in a cluster config handler right before it takes the lock the
+// replay holds there. Together they let a test put a newer announcement into
+// exactly that gap.
+var (
+	TestHookReplayRead           atomic.Pointer[func(folderID string, device protocol.DeviceID)]
+	TestHookAnnouncementsLocking atomic.Pointer[func(device protocol.DeviceID)]
+)
