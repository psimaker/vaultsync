+// closeConnectionsBeyondLimit closes the newest connections to d, by
+// connection ID (identical on both ends), until at most limit remain.
+// VaultSync (#185).
+func (c *deviceConnectionTracker) closeConnectionsBeyondLimit(d protocol.DeviceID, limit int) {
+	c.connectionsMut.Lock()
+	defer c.connectionsMut.Unlock()
+	if limit <= 0 || len(c.connections[d]) <= limit {
+		return
+	}
+	sorted := slices.Clone(c.connections[d])
+	slices.SortFunc(sorted, func(a, b protocol.Connection) int {
+		return strings.Compare(a.ConnectionID(), b.ConnectionID())
+	})
+	for _, conn := range sorted[limit:] {
+		l.Debugf("Closing connection %s to %s beyond the negotiated limit of %d", conn, d.Short(), limit)
+		go conn.Close(errTooManyConnections)
+	}
+}
