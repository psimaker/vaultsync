<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  VaultSync for Mac.app (decision 052): the menu-bar app is the bundle's executable,
  the agent sits beside it in Contents/MacOS. make-app.sh fills in
  @VERSION@. LSUIElement: a menu-bar icon, no Dock icon, no main menu.
  LSMinimumSystemVersion matches the binaries' minos (Go's floor, and the
  tray's cgo build pins it with -mmacosx-version-min).
  NSLocalNetworkUsageDescription was meant for the agent, which finds the
  Hub on the local network; the tray uses no network. On the signed build it
  does not reach the agent: macOS's question names "vaultsync" and shows its
  generic text (decision 052, #286).
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>VaultSync for Mac</string>
	<key>CFBundleExecutable</key>
	<string>vaultsync-tray</string>
	<key>CFBundleIdentifier</key>
	<string>eu.vaultsync.desktop</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>VaultSync for Mac</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key>
	<string>12.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>VaultSync looks for your VaultSync Hub on your local network to pair with it, and syncs your vaults with it there.</string>
</dict>
</plist>
